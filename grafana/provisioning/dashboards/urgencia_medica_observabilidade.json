{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "uid": "urgencia-medica-observ",
  "title": "Urgência Médica — Observabilidade da API ML",
  "tags": ["postech", "ml-challenge", "urgencia-medica", "prometheus", "fastapi"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"]
  },
  "variables": [
    {
      "name": "DS_PROM",
      "type": "datasource",
      "label": "Prometheus",
      "query": "prometheus",
      "current": {
        "selected": true,
        "text": "Prometheus",
        "value": "urgencia-prometheus"
      },
      "hide": 0
    }
  ],
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Health / Disponibilidade — Modelo Carregado",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "fieldOptions": {
          "calcs": ["lastNotNull"],
          "overrides": [
            { "matcher": { "id": "byValue", "options": { "op": "neq", "value": 1 } }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
            { "matcher": { "id": "byValue", "options": { "op": "eq", "value": 1 } }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (model_name) (model_loaded == 1) or on() vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "displayName": "Modelo",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NÃO carregado" }, "1": { "text": "CARREGADO" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Total Requisições (acumulado)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum(http_requests_total)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "req", "displayName": "Requests (total acumulado)" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Total Predições (acumulado)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" }, "expr": "sum(inference_predictions_total)", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "pred", "displayName": "Predições (total)" }
      }
    },
    {
      "id": 4,
      "title": "Erro Rate (%) — 5xx",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "100 * clamp_min(sum(rate(http_errors_total{status_family=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total[$__rate_interval])), 0.0001), 0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "thresholds",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "Erro 5xx",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "📈 QPS / Taxa de Requisições por Endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (endpoint) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "spanNulls": 60, "fillOpacity": 20, "lineWidth": 2 } },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Distribuição de Requisições por HTTP Status (stacked)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (status_code) (rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "status {{status_code}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 0, "stacking": { "mode": "normal" } }
        }
      }
    },
    {
      "id": 20,
      "title": "⏱️ Latência HTTP por Endpoint — P50 / P95 / P99 (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P50 {{endpoint}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P95 {{endpoint}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "P99 {{endpoint}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 2, "spanNulls": 60 }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "P99.*" }, "properties": [{ "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [4, 2] } }] },
          { "matcher": { "id": "byRegexp", "options": "P95.*" }, "properties": [{ "id": "color", "value": { "mode": "palette-classic", "palette": 3 } }] }
        ]
      }
    },
    {
      "id": 25,
      "title": "⏱️ Latência Exclusiva do Modelo (ML predict, sem HTTP) — P50/P95/P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" }, "expr": "histogram_quantile(0.50, sum by (le, endpoint_type) (rate(inference_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "ML P50 {{endpoint_type}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" }, "expr": "histogram_quantile(0.95, sum by (le, endpoint_type) (rate(inference_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "ML P95 {{endpoint_type}}" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" }, "expr": "histogram_quantile(0.99, sum by (le, endpoint_type) (rate(inference_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "ML P99 {{endpoint_type}}" }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 5 }
      }
    },
    {
      "id": 30,
      "title": "❌ Erros HTTP — Taxa (%) Total 4xx e 5xx",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "100 * sum(rate(http_errors_total{status_family=\"4xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total[$__rate_interval])), 0.0001)",
          "legendFormat": "4xx (%)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "100 * sum(rate(http_errors_total{status_family=\"5xx\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total[$__rate_interval])), 0.0001)",
          "legendFormat": "5xx (%)"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx (%)" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 35,
      "title": "🧮 Quantidade — Erros de Inferência por Tipo (acumulado)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (error_type) (increase(inference_errors_total[$__range]))",
          "legendFormat": "{{error_type}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "donut",
        "displayLabels": ["name", "value", "percent"]
      }
    },
    {
      "id": 40,
      "title": "🏷️ Distribuição de Classes Preditas por ML (último período)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (predicted_class) (increase(inference_predictions_total[$__range]))",
          "legendFormat": "{{predicted_class}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "pie",
        "displayLabels": ["name", "value", "percent"]
      }
    },
    {
      "id": 45,
      "title": "🔁 Taxa de Predições por Classe (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (predicted_class) (rate(inference_predictions_total[$__rate_interval]))",
          "legendFormat": "{{predicted_class}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": { "unit": "predps" }
      }
    },
    {
      "id": 50,
      "title": "🔍 Tabela — Detalhamento de Erros HTTP por Endpoint x Status (último período)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "urgencia-prometheus" },
          "expr": "sum by (endpoint, status_code, status_family) (increase(http_errors_total[$__range]))",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "metric.endpoint": "Endpoint",
              "metric.status_code": "HTTP Status",
              "metric.status_family": "Familia",
              "Value": "N Erros"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "fields": ["N Erros"],
          "reducer": ["sum"],
          "show": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Familia" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "4xx": { "color": "orange", "text": "4xx Cliente" },
                      "5xx": { "color": "red", "text": "5xx Servidor" }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
